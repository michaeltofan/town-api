HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Deployment identity and lifecycle (Deployment Readiness V1).
# APP_ENV is the authoritative runtime environment name for logs, /health/build,
# and fail-closed configuration. When unset, defaults from NODE_ENV mapping.
# Allowed values: development | test | staging | production.
APP_ENV=development
# Required in staging/production; optional locally. Commit SHA of the deployed build.
# No whitespace; max 128 characters.
# APP_COMMIT_SHA=0000000000000000000000000000000000000000
# Optional ISO-8601 build timestamp emitted by the build environment.
# APP_BUILD_TIMESTAMP=2026-07-17T00:00:00Z
# Bounded readiness probe timeout in milliseconds (100–60000). Default 3000.
READINESS_TIMEOUT_MS=3000
# Bounded graceful shutdown timeout in milliseconds (100–120000). Default 10000.
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL connection string (required). Use local/non-secret values only.
DATABASE_URL=postgres://town:town@127.0.0.1:5432/town

# Pool settings
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Temporary controlled confirmation (NOT real authentication).
# Disabled by default. When enabled, KEY and TEST_ACTOR_ID are required.
# Never commit real secrets. Placeholder values only.
CONTROLLED_CONFIRMATION_ENABLED=false
# CONTROLLED_CONFIRMATION_KEY=replace-with-local-non-secret-placeholder
# CONTROLLED_TEST_ACTOR_ID=00000000-0000-4000-8000-000000000301

# Email verification runtime (NOT production email delivery).
# Disabled by default. When enabled, hash keys and delivery mode are required.
# Production cannot enable this slice while only test/development adapters exist.
# Never commit real secrets. Placeholder values only.
EMAIL_VERIFICATION_ENABLED=false
# EMAIL_VERIFICATION_HASH_KEY=replace-with-local-dev-hash-key-32chars-min
# CEREMONY_RATE_LIMIT_HASH_KEY=replace-with-local-rate-limit-key-32chars
# EMAIL_VERIFICATION_DELIVERY_MODE=development

# WebAuthn first-passkey registration runtime (NOT login/session issuance).
# Disabled by default. When enabled, RP/origin values and hash keys are required.
# Also requires EMAIL_VERIFICATION_HASH_KEY (setup-grant hash compatibility) and
# CEREMONY_RATE_LIMIT_HASH_KEY. Production must use exact towncivic.org policy.
# Never commit real secrets. Placeholder values only.
WEBAUTHN_REGISTRATION_ENABLED=false
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=TOWN
# WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
# WEBAUTHN_CHALLENGE_HASH_KEY=replace-with-local-webauthn-challenge-key-32chars

# Passkey authentication + session runtime.
# Disabled by default. Requires WEBAUTHN_RP_ID, WEBAUTHN_ALLOWED_ORIGINS,
# CEREMONY_RATE_LIMIT_HASH_KEY, PASSKEY_AUTHENTICATION_CHALLENGE_HASH_KEY,
# and SESSION_TOKEN_HASH_KEY. Web sessions use a Secure HttpOnly __Host cookie.
# Never commit real secrets. Placeholder values only.
PASSKEY_AUTHENTICATION_ENABLED=false
# PASSKEY_AUTHENTICATION_CHALLENGE_HASH_KEY=replace-with-local-auth-challenge-key-32chars
# SESSION_TOKEN_HASH_KEY=replace-with-local-session-token-key-32chars
# WEB_SESSION_COOKIE_NAME=__Host-Http-town_session

# Account recovery runtime (NOT production email delivery; NOT login sessions).
# Disabled by default. When enabled, recovery hash keys, delivery mode,
# CEREMONY_RATE_LIMIT_HASH_KEY, and WEBAUTHN_* (RP, origins, challenge hash) are required.
# Production cannot enable this slice while only test/development adapters exist.
# Never commit real secrets. Placeholder values only.
ACCOUNT_RECOVERY_ENABLED=false
# ACCOUNT_RECOVERY_HASH_KEY=replace-with-local-recovery-hash-key-32chars-min
# ACCOUNT_RECOVERY_TOKEN_HASH_KEY=replace-with-local-recovery-token-key-32chars
# ACCOUNT_RECOVERY_DELIVERY_MODE=development

# Stripe billing runtime (Membership Foundation V1 — Slice 2).
# Disabled by default. When enabled, all Stripe values are required, along with the
# passkey-authentication session runtime (PASSKEY_AUTHENTICATION_ENABLED and its keys),
# because /v1/billing/checkout-session and /v1/billing/customer-portal-session require
# an active session. Never commit real secrets. Placeholder values only.
STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_replace_with_local_stripe_test_key_placeholder
# STRIPE_WEBHOOK_SECRET=whsec_replace_with_local_stripe_webhook_secret_placeholder
# STRIPE_ANNUAL_PRICE_ID=price_replace_with_local_stripe_annual_price_id
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_with_local_stripe_portal_configuration
# STRIPE_CHECKOUT_SUCCESS_URL=https://example.test/checkout/success
# STRIPE_CHECKOUT_CANCEL_URL=https://example.test/checkout/cancel
# STRIPE_PORTAL_RETURN_URL=https://example.test/portal/return
# STRIPE_API_VERSION=2026-06-24.dahlia
# STRIPE_EXPECTED_LIVEMODE=false

# Trusted proxy behavior for request.ip. Default false (do not trust X-Forwarded-For).
TRUST_PROXY=false

# ---- Staging / Production deployment notes (no secrets) ----
# In staging (APP_ENV=staging):
#   * APP_COMMIT_SHA is required.
#   * When STRIPE_BILLING_ENABLED=true, STRIPE_EXPECTED_LIVEMODE must be false
#     and STRIPE_SECRET_KEY must not begin with sk_live_.
# In production (APP_ENV=production or NODE_ENV=production):
#   * APP_COMMIT_SHA is required (no whitespace).
#   * DATABASE_URL must not contain localhost / 127.0.0.1 / town:town@ credentials.
#   * WEBAUTHN_ALLOWED_ORIGINS must not include localhost or 127.0.0.1.
#   * WEBAUTHN_RP_ID must not be localhost.
#   * STRIPE_EXPECTED_LIVEMODE must be true when STRIPE_BILLING_ENABLED=true.
#   * Known CI placeholder hash keys are rejected.
