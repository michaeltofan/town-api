HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string (required). Use local/non-secret values only.
DATABASE_URL=postgres://town:town@127.0.0.1:5432/town

# Pool settings
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# Temporary controlled confirmation (NOT real authentication).
# Disabled by default. When enabled, KEY and TEST_ACTOR_ID are required.
# Never commit real secrets. Placeholder values only.
CONTROLLED_CONFIRMATION_ENABLED=false
# CONTROLLED_CONFIRMATION_KEY=replace-with-local-non-secret-placeholder
# CONTROLLED_TEST_ACTOR_ID=00000000-0000-4000-8000-000000000301
