{
  "name": "town-api",
  "version": "0.1.0",
  "private": true,
  "description": "TOWN API — Fastify 5 + TypeScript foundation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi:generate": "tsx scripts/openapi.ts generate",
    "openapi:check": "tsx scripts/openapi.ts check",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:test": "tsx scripts/db-migrate-test.ts",
    "db:seed:foundation": "tsx scripts/seed-foundation-content.ts",
    "db:seed:controlled-actor": "tsx scripts/seed-controlled-actor.ts",
    "identity:fixtures:load": "tsx scripts/load-identity-fixtures.ts",
    "identity:contract:generate": "tsx scripts/identity-contract.ts generate",
    "identity:contract:check": "tsx scripts/identity-contract.ts check",
    "auth:fixtures:load": "tsx scripts/load-ceremony-fixtures.ts",
    "auth:contract:generate": "tsx scripts/auth-contract.ts generate",
    "auth:contract:check": "tsx scripts/auth-contract.ts check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run openapi:check && npm run identity:contract:check && npm run auth:contract:check && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/swagger": "^9.5.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@simplewebauthn/server": "13.3.2",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
